# Ảnh gốc: ĐƯỢC commit (tài nguyên ảnh do chủ dự án chụp)
#   dataset/raw/{unripe,medium_ripe,ripe}/        (dataset cũ)
#   datasets/<id>/raw/<class>/                    (dataset mới)
# Chỉ loại trừ thư mục rỗng, không loại trừ ảnh.
dataset/raw/*/.gitkeep
datasets/*/raw/*/.gitkeep

# Dữ liệu DẪN XUẤT & sinh tự động (tái tạo được) — không commit
dataset/derived/
datasets/*/derived/
dataset/train/**/*
dataset/validation/**/*
dataset/test/**/*
dataset/split_manifest*.json
dataset/groups.csv
experiments/
exports/
.pipeline_staging/
tools/make-object-to-center/examples/red-chili/input/

# Model & artifact sinh ra khi huấn luyện/export
artifacts/
models/checkpoints/**/*
models/saved_model/**/*
reports/figures/**/*
reports/metrics/**/*
!models/checkpoints/.gitkeep
!models/saved_model/.gitkeep
!reports/figures/.gitkeep
!reports/metrics/.gitkeep
!reports/metrics/crop_v1_report.json

# TFLite/model file lạc (bất cứ đâu) — phòng ngừa
models/tflite/**/*
!models/tflite/.gitkeep
*.tflite
*.keras
*.h5
*.hdf5
*.pb
*.savedmodel
*.onnx
# Deployment: model TFLite nhỏ cần commit để chạy trên Termux
!deployment/task6/models/*.tflite
!deployment/task6/models/*.json

# Python & env
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
*.egg-info/
.tox/
.coverage
htmlcov/

# Android (giai đoạn sau)
.gradle/
build/
*.apk
*.aab
local.properties
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# OS / editor
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
nohup.out
*.zip
